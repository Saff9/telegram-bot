# Telegram API Credentials
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# Bot Token from @BotFather
BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ

# Local Bot API Server URL (Set automatically by Docker)
TELEGRAM_API_BASE_URL=http://local-bot-api:8081

# OpenRouter API Key (Optional: for AI-generated titles/captions)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of the channel where videos will be posted
# Format: -100xxxxxxxxxx
CHANNEL_ID=-1001234567890
